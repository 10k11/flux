# Your domain, e.g. dl.example.com (DNS A/AAAA must point at your server)
FLUX_PUBLIC_HOST=media.example.com

# ---- Choose ONE mode ----
# Private mode (personal / small trusted group): set a long random password.
FLUX_ACCESS_PASSWORD=
# Public mode (anyone on the internet can use the site): set to 1 and leave
# the password empty. Rate limits + per-visitor queues apply automatically.
FLUX_PUBLIC_OPEN=0

# ---- Public-mode tuning (safe defaults, change if you know your server) ----
# Simultaneous downloads across the whole server (each burns CPU + bandwidth)
FLUX_MAX_CONCURRENT=2
# Largest single file the server will fetch (media engine --max-filesize)
FLUX_MAX_FILESIZE=4G
# Finished files are deleted after this many hours
FLUX_RETENTION_HOURS=24
# Link checks allowed per visitor per 10 minutes
FLUX_INSPECT_PER_10MIN=40
# Downloads started per visitor per hour
FLUX_JOBS_PER_HOUR=15
# Active (queued + downloading) jobs per visitor
FLUX_ACTIVE_PER_VISITOR=6
# Google OAuth (server-side only). Create a Web application client in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact canonical origin, no trailing slash. HTTPS is required outside localhost.
FLUX_ORIGIN=http://localhost:3000
# Maximum permitted source duration, in seconds (applies to full files and previews).
FLUX_MAX_DURATION=7200
# Aggregate temporary bytes per running job, including source and output.
FLUX_MAX_JOB_BYTES=4294967296
# Enable only behind your controlled reverse proxy, which overwrites forwarding headers.
FLUX_TRUST_PROXY=0
# Optional comma-separated additional public source hostnames, reviewed by the operator.
FLUX_EXTRA_SOURCE_HOSTS=
